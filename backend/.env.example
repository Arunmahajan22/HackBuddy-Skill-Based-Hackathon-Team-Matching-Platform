NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hackbuddy
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Nodemailer / SMTP Configuration (e.g. Gmail, SendGrid, Mailgun, Brevo, Ethereal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM="HackBuddy" <no-reply@hackbuddy.dev>
